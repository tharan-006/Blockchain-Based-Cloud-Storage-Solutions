# Blockchain Settings
BLOCKCHAIN_DIFFICULTY=3
BLOCKCHAIN_DATA_FILE=data/blockchain_ledger.json
DATABASE_PATH=data/app.db

# Flask Server Port
PORT=5000
DEBUG=True
